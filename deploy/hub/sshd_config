# sshd_config for the wkp-hub front-door container (design 8.1, M5-5).
#
# Every client connects as the single shared `git` account (the
# gitolite pattern design 8.1 cites) -- there is deliberately no
# per-tenant Unix user yet (that's the pod-per-tenant model, ADR-0009,
# M5-7). Isolation between tenants at this stage is entirely
# `wkp-shell`'s own application-level path restriction: this file's job
# is to make sure nothing *other* than that restricted path is ever
# reachable at all (no passwords, no forwarding, no interactive shell,
# no untrusted per-user authorized_keys file).

Port 22
Protocol 2

# No password/keyboard-interactive login at all -- key-only, and only
# a key this container's control plane actually resolves to a tenant
# (AuthorizedKeysCommand below) ever gets in.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
HostbasedAuthentication no
UsePAM no

# ed25519-only (design 8.1's own hardening list): both directions.
# `wkp hub register` (M5-2) only ever generates ed25519 signing
# identities, so this rejects nothing a real client needs and refuses
# every weaker key type outright.
PubkeyAcceptedAlgorithms ssh-ed25519
HostKey /etc/ssh/ssh_host_ed25519_key
HostKeyAlgorithms ssh-ed25519

# No per-user `~/.ssh/authorized_keys` file at all -- every key must
# come from the control plane via AuthorizedKeysCommand below, never
# from a file a compromised or misconfigured account could plant one
# into. A path that can never exist (found by hand: `/dev/null` seems
# like the obvious way to disable this, but this sshd build hard-rejects
# it -- "authorized keys '/dev/null' is not a regular file" -- whereas a
# simply-missing file is sshd's normal, silently-empty case).
AuthorizedKeysFile /etc/ssh/authorized_keys_disabled/%u

# The key-to-tenant mapping (M5-3): looks up the presented key, returns
# a `command="wkp-hub git-shell <tenant-slug>",restrict` line for an
# active device, or nothing at all for an unknown/revoked one. Runs as
# a dedicated low-privilege account, never as root or as the shared
# `git` login user itself -- sshd's own requirement for this directive,
# and defense in depth: this process is what decides who gets in at
# all, so it should not itself be a valid login target or share
# filesystem access with the sessions it authorizes.
AuthorizedKeysCommand /usr/local/bin/wkp-hub-akc.sh %t %k
AuthorizedKeysCommandUser wkp-akc

# `restrict` (set by the AuthorizedKeysCommand's own emitted line,
# OpenSSH 7.2+) already disables agent/X11/TCP forwarding and a pty for
# the connections it authorizes; these restate the same policy at the
# server-config level too, so nothing depends on `restrict` alone.
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
PermitTTY no
PermitTunnel no
GatewayPorts no

# No sftp, no other subsystems -- only git-receive-pack/git-upload-pack
# via the forced `command=` from AuthorizedKeysCommand's own line.

# Fewer than the default 6 concurrent unauthenticated connections is
# plenty for what a single tenant's device count looks like at this
# stage; kept modest rather than the default to reduce the
# pre-auth-connection attack surface. Revisit under real load.
MaxStartups 10:30:60

LogLevel VERBOSE
