# wkp-hub front-door container (design 8.1/8.3, M5-5; ADR-0011/#125:
# HTTPS + mutual TLS only, the original SSH transport removed). Per-tenant
# hard isolation (a pod per tenant) is ADR-0009/M5-7's job, not this
# image's.
#
# Fedora-based (quay.io/fedora), built and run with podman -- standing
# preference, not specific to this task.
#
# Build from the workspace root:
#   podman build -f deploy/hub/Containerfile -t wkp-hub .

FROM quay.io/fedora/fedora-minimal:41 AS builder

# gcc: rustc needs a linker. openssl-devel/pkgconf-pkg-config: the
# `postgres` crate's TLS-adjacent dependencies probe for these at build
# time even though this workspace's own `postgres` usage is NoTls
# (M5-1) -- cheaper to provide them than to fight the build over it.
RUN microdnf install -y --setopt=install_weak_deps=0 \
        gcc openssl-devel pkgconf-pkg-config git tar xz \
    && microdnf clean all

# rustup, not a distro rustc package: CLAUDE.md pins the toolchain in
# rust-toolchain.toml (currently 1.98.1), and this must build with
# exactly that version, not whatever Fedora 41 happens to ship.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- --profile minimal --default-toolchain none -y

WORKDIR /src
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tests ./tests
# `rustup show` alone installs the pinned toolchain named in
# rust-toolchain.toml (rustup's own documented trigger for this), so
# the actual `cargo build` below uses exactly that version.
RUN rustup show
RUN cargo build --release -p wkp-hub

FROM quay.io/fedora/fedora-minimal:41

# podman-remote (ADR-0012): `tenant_pod.rs`'s `PodmanOrchestrator`
# shells out to a binary literally named `podman`, but this container
# never runs its own container-runtime daemon -- pods it starts are
# siblings on the *host*, not nested inside this container (ADR-0009's
# whole point). `podman-remote` is the lean, daemon-free client half of
# podman, built to always talk to a remote API socket
# (`CONTAINER_HOST`, set by whatever starts this container -- see
# entrypoint.sh); symlinked to the plain `podman` name the Rust code
# already expects, so no code needs to know which one it's talking to.
RUN microdnf install -y --setopt=install_weak_deps=0 \
        git podman-remote \
    && microdnf clean all \
    && ln -s /usr/bin/podman-remote /usr/bin/podman \
    && mkdir -p /srv/wkp-hub/repos

# `git-receive-pack`/`git http-backend` (this container's own front
# door, and every tenant pod's `serve-tenant` mode) refuses a repo it
# doesn't consider itself the owner of ("detected dubious ownership")
# whenever the UID that created a file differs from the UID reading it
# now -- a real, ordinary occurrence here even with a single account
# (root) in this container alone, since a tenant's bare repo lives on
# a host-shared bind mount (`/srv/wkp-hub/repos`, ADR-0012) that a
# *different* container -- a tenant's own pod -- also mounts and reads
# from, each under its own rootless-podman UID mapping. Every repo
# under this path belongs to this one service regardless of which
# container touches it, so there is no untrusted third party this
# config would wrongly extend trust to.
RUN printf '[safe]\n\tdirectory = *\n' > /etc/gitconfig

COPY --from=builder /src/target/release/wkp-hub /usr/local/bin/wkp-hub
COPY deploy/hub/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/wkp-hub /usr/local/bin/entrypoint.sh

EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
