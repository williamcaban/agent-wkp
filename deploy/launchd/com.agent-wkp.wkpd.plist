<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  wkpd: watch-triggered automation for a single wkp store (M3-8, design
  4.2/7.5). Runs as the invoking user via launchd, not as root or a
  system-wide LaunchDaemon.

  NOTE (docs/adr/0004-wkpd-peer-credential-verification.md): `wkpd`
  itself refuses to bind its control socket on macOS today -- this repo's
  only safe (no local `unsafe` code), already-vetted dependency for
  Unix-socket peer-credential verification (`rustix`) does not yet
  support macOS's `LOCAL_PEERCRED` mechanism (upstream issue
  bytecodealliance/rustix#1533). This unit is shipped as the documented
  intended deployment shape for when that support lands, not as a claim
  that `wkpd` runs on macOS today. Running `wkp sync`/`wkp remember`/etc.
  directly (without `wkpd`) is unaffected and fully supported on macOS.

  Install (per store):
    cp deploy/launchd/com.agent-wkp.wkpd.plist ~/Library/LaunchAgents/
    # Edit the three placeholders below for your setup, then:
    launchctl load ~/Library/LaunchAgents/com.agent-wkp.wkpd.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-wkp.wkpd</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Edit these three for your setup (absolute paths; launchd
             does not expand ~ or $HOME). -->
        <string>/usr/local/bin/wkp</string>
        <string>wkpd</string>
        <string>--path</string>
        <string>/REPLACE_ME/STORE_PATH</string>
        <string>--principal</string>
        <string>REPLACE_ME_PRINCIPAL</string>
        <string>--signing-key-file</string>
        <string>/REPLACE_ME/SIGNING_KEY_FILE</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/REPLACE_ME/STORE_PATH/.wkp/wkpd.log</string>
    <key>StandardErrorPath</key>
    <string>/REPLACE_ME/STORE_PATH/.wkp/wkpd.log</string>
</dict>
</plist>
